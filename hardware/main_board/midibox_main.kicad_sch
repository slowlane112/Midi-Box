(text "MIDI Box main board  -  90 x 70 mm, M2 holes 2 mm from each edge (86 x 66 mm between centres)" (exclude_from_sim no) (at 20.32 20.32 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "3100df13-4f60-4c1a-94f2-77051b4ee546"))
